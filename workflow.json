        "operation": "upload",
        "name": "=digest_{{ $('Set Run Context').item.json.date_iso }}.json",
        "binaryData": false,
        "fileContent": "={{ JSON.stringify($json, null, 2) }}",
        "parents": { "values": [ { "folderId": "TODO_OUTPUTS_BENDER_WHATSAPP_DIGEST_FOLDER_ID" } ] }
      },
      "id": "drive-write-audit",
      "name": "OUTPUT: Drive write audit JSON",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [4700, 260],
      "credentials": {
        "googleApi": { "id": "m4byl5nfbNY3sE95", "name": "Google SA - n8n-whatsapp-uploader" }
      }
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "#wa-digest-v2-shadow", "mode": "name" },
        "text": "=⚠️ Digest {{ $('Set Run Context').item.json.date_iso }} failed validation ({{ ($json.dropped_pct * 100).toFixed(1) }}% references unverified).\nFull debug payload in thread.",
        "otherOptions": { "mrkdwn": true }
      },
      "id": "slack-post-stub-failed",
      "name": "FAIL: Slack stub post",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [4260, 540]
    },
    {
      "parameters": {
        "operation": "upload",
        "name": "=digest_{{ $('Set Run Context').item.json.date_iso }}.failed.json",
        "binaryData": false,
        "fileContent": "={{ JSON.stringify($json, null, 2) }}",
        "parents": { "values": [ { "folderId": "TODO_OUTPUTS_BENDER_WHATSAPP_DIGEST_FOLDER_ID" } ] }
      },
      "id": "drive-write-failed",
      "name": "FAIL: Drive write .failed.json",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [4480, 540],
      "credentials": {
        "googleApi": { "id": "m4byl5nfbNY3sE95", "name": "Google SA - n8n-whatsapp-uploader" }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO digest_runs (run_at, trigger, messages_count, hard_gate_pct, posted, failed_reason) VALUES (now(), $1, $2, $3, $4, $5)",
        "additionalFields": { "queryReplacement": "={{ JSON.stringify([$json.trigger, $json.messages_count, $json.dropped_pct, $json.posted, $json.failed_reason]) }}" }
      },
      "id": "pg-audit-runs",
      "name": "AUDIT: insert digest_runs row",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [4920, 400]
    }
