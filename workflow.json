    {
      "parameters": {
        "method": "POST",
        "url": "http://10.10.96.75:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"gemma2:9b\",\n  \"prompt\": \"You are drafting a daily digest of WhatsApp beta tester feedback for Rolla.\\n\\nRULES:\\n- Top-level digest MUST be ≤300 words.\\n- Sections: Volume / Top issues / Praise / Suggested follow-ups / High-urgency / Codebase + roadmap cross-check\\n- Every Linear ID, file path, and roadmap (Linear project) item you mention MUST come from the provided verified_matches block. Do not invent references.\\n- If unsure about a reference, write '(unverified)' — do not guess.\\n- BS/HR/SL/EN messages are equal. Do not translate; quote inline if useful.\\n\\nINPUT:\\nmessages_enriched: {{ JSON.stringify($json.messages_enriched) }}\\nverified_matches: {{ JSON.stringify($json.verified_matches) }}\\n\",\n  \"stream\": false,\n  \"options\": { \"temperature\": 0.2, \"num_ctx\": 8192 },\n  \"keep_alive\": \"24h\"\n}",
        "options": { "timeout": 120000 }
      },
      "id": "llm-assembly",
      "name": "STAGE 3: LLM assembly (gemma2:9b)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [3580, 400]
    },
    {
      "parameters": { "command": "=python3 scripts/validate_digest.py --digest \"$(echo {{ $json.response | base64 }} | base64 -d)\" --matches '{{ JSON.stringify($json.verified_matches) }}' --drop-pct-threshold 0.20" },
      "id": "hard-gate-validate",
      "name": "STAGE 3: Hard gate (regex + 20% threshold)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [3800, 400],
      "notes": "Returns JSON: { passed: bool, dropped_pct: float, cleaned_digest: string, dropped_references: [...] }"
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "options": { "caseSensitive": true }, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.passed }}", "rightValue": "true", "operator": { "type": "boolean", "operation": "equals" } } ] }, "renameOutput": true, "outputKey": "pass" },
            { "conditions": { "options": { "caseSensitive": true }, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.passed }}", "rightValue": "false", "operator": { "type": "boolean", "operation": "equals" } } ] }, "renameOutput": true, "outputKey": "fail" }
          ]
        }
      },
      "id": "router-gate",
      "name": "Gate router (pass | fail)",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [4020, 400]
    },
    {
      "parameters": {
        "select": "channel",
        "channelId": { "__rl": true, "value": "#wa-digest-v2-shadow", "mode": "name" },
        "text": "={{ $json.cleaned_digest }}",
        "otherOptions": { "mrkdwn": true }
      },
      "id": "slack-post-top",
      "name": "OUTPUT: Slack post → #wa-digest-v2-shadow",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [4260, 260]
