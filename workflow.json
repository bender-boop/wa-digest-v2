      "typeVersion": 3.1,
      "position": [1560, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "options": { "caseSensitive": true }, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.type }}", "rightValue": "text", "operator": { "type": "string", "operation": "equals" } } ] }, "renameOutput": true, "outputKey": "text" },
            { "conditions": { "options": { "caseSensitive": true }, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.type }}", "rightValue": "photo", "operator": { "type": "string", "operation": "equals" } } ] }, "renameOutput": true, "outputKey": "photo" },
            { "conditions": { "options": { "caseSensitive": true }, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.type }}", "rightValue": "video", "operator": { "type": "string", "operation": "equals" } } ] }, "renameOutput": true, "outputKey": "video" },
            { "conditions": { "options": { "caseSensitive": true }, "combinator": "and", "conditions": [ { "leftValue": "={{ $json.type }}", "rightValue": "audio", "operator": { "type": "string", "operation": "equals" } } ] }, "renameOutput": true, "outputKey": "audio" }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "router-stage1",
      "name": "STAGE 1 router (text|photo|video|audio)",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [1780, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://10.10.96.75:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"qwen2.5vl:7b\",\n  \"prompt\": \"You are analyzing a screenshot from a beta tester of the Rolla fitness mobile app. Describe what is visible in 2-4 short sentences. Focus on visible UI elements, error messages, app state, numeric values displayed, and any sign of malfunction. Do NOT speculate about cause. If unrelated to the app, say 'unrelated'.\",\n  \"images\": [\"{{ $json.media_b64 }}\"],\n  \"stream\": false,\n  \"keep_alive\": \"24h\"\n}",
        "options": { "timeout": 30000 }
      },
      "id": "vlm-photo",
      "name": "STAGE 1: VLM photo (qwen2.5vl:7b)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2020, 140]
    },
    {
      "parameters": { "command": "=bash scripts/extract_keyframes.sh \"{{ $json.media_file }}\" 0.5 10" },
      "id": "ffmpeg-keyframes",
      "name": "STAGE 1: ffmpeg → 10 keyframes @0.5fps",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [2020, 320],
      "notes": "Calls shell wrapper that runs:\nffmpeg -i <in> -vf 'fps=0.5,scale=1280:-2' -frames:v 10 -q:v 4 frame_%02d.jpg\nThen pHash dedupe (threshold 8) and emits surviving frame paths as JSON."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://10.10.96.75:11434/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"qwen2.5vl:7b\",\n  \"prompt\": \"These are sequential frames from a short screen recording of the Rolla fitness mobile app. Describe the sequence as a flow in 3-6 sentences. Focus on user actions, app state changes, and any errors. If unrelated to the app, say 'unrelated'.\",\n  \"images\": {{ $json.frames_b64 }},\n  \"stream\": false,\n  \"keep_alive\": \"24h\"\n}",
        "options": { "timeout": 60000 }
      },
      "id": "vlm-video-batch",
      "name": "STAGE 1: VLM video frames batch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2240, 320]
    },
    {
      "parameters": { "command": "=whisper-cpp -m models/ggml-medium.bin -l auto -of json \"{{ $json.media_file }}\"" },
      "id": "whisper-audio",
      "name": "STAGE 1: whisper.cpp audio transcript",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [2020, 500],
      "notes": "Auto-detects language. Native transcript for BS/HR/SL/EN."
    },
    {
      "parameters": { "mode": "passThrough", "options": {} },
      "id": "merge-enriched",
      "name": "Merge: enriched messages",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [2460, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://10.10.96.75:11434/api/embeddings",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"bge-m3\",\n  \"prompt\": \"{{ $json.text }}\\n\\n{{ $json.observed_content }}\"\n}",
        "options": { "timeout": 15000 }
      },
      "id": "embed-bge-m3",
      "name": "STAGE 2: embed (bge-m3, 1024d)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2680, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT issue_id, title, state, project_id, 1 - (embedding <=> $1::vector) AS cosine FROM linear_index WHERE 1 - (embedding <=> $1::vector) >= 0.75 ORDER BY embedding <=> $1::vector LIMIT 10",
        "additionalFields": { "queryReplacement": "={{ JSON.stringify($json.embedding) }}" }
      },
      "id": "pgvector-linear",
      "name": "STAGE 2: pgvector → linear_index",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2900, 160]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT project_id, name, state, target_date, 1 - (embedding <=> $1::vector) AS cosine FROM linear_projects_index WHERE 1 - (embedding <=> $1::vector) >= 0.70 ORDER BY embedding <=> $1::vector LIMIT 5",
        "additionalFields": { "queryReplacement": "={{ JSON.stringify($json.embedding) }}" }
      },
      "id": "pgvector-projects",
      "name": "STAGE 2: pgvector → linear_projects_index (roadmap)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2900, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT repo, path, docstring, 1 - (embedding <=> $1::vector) AS cosine FROM codebase_index WHERE 1 - (embedding <=> $1::vector) >= 0.70 ORDER BY embedding <=> $1::vector LIMIT 8",
        "additionalFields": { "queryReplacement": "={{ JSON.stringify($json.embedding) }}" }
      },
      "id": "pgvector-codebase",
      "name": "STAGE 2: pgvector → codebase_index",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2900, 440]
    },
    {
      "parameters": {
        "resource": "ticket",
        "operation": "search",
        "additionalFields": { "query": "=requester:{{ $json.sender_phone }} created>{{ $now.minus({hours: 48}).toISO() }}" }
      },
      "id": "zendesk-hard-dedupe",
      "name": "STAGE 2: Zendesk hard dedupe (phone ±48h)",
      "type": "n8n-nodes-base.zendesk",
      "typeVersion": 1,
      "position": [2900, 580],
      "credentials": {
        "zendeskApi": { "id": "VYVmkciKDc9RACBS", "name": "Zendesk - rollacompany (Bender v2 digest)" }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT ticket_id, subject, status, 1 - (embedding <=> $1::vector) AS cosine FROM zendesk_index WHERE 1 - (embedding <=> $1::vector) >= 0.82 AND created_at > now() - interval '7 days' ORDER BY embedding <=> $1::vector LIMIT 5",
        "additionalFields": { "queryReplacement": "={{ JSON.stringify($json.embedding) }}" }
      },
      "id": "pgvector-zendesk-soft",
      "name": "STAGE 2: Zendesk soft dedupe (cosine ≥0.82, ±7d)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [2900, 720]
